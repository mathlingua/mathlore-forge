# Environment Configuration for Mathlore Agent

# Gemini API Key (required for Google Antigravity SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to Mathlore repository (defaults to ../../mathlore)
MATHLORE_REPO_PATH=../../mathlore

# Optional: Path to Mathlingua binary (defaults to ../../mathlingua/target/release/mlg or target/debug/mlg)
MLG_BIN_PATH=../../mathlingua/target/release/mlg

# Optional: DBOS System Database URL (defaults to sqlite:///mathlore_agent.sqlite)
# For Postgres: postgresql://user:password@localhost:5432/mathlore_agent
DBOS_SYSTEM_DATABASE_URL=sqlite:///mathlore_agent.sqlite

# Optional: OpenTelemetry OTLP Endpoint (e.g. for Jaeger/SigNoz)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
